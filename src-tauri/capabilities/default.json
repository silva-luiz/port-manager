{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window: core, three notification commands and each app command explicitly.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify",
    "allow-health-check",
    "allow-list-ports",
    "allow-process-details",
    "allow-terminate-process",
    "allow-list-favorites",
    "allow-add-favorite",
    "allow-remove-favorite",
    "allow-get-settings",
    "allow-set-language",
    "allow-set-auto-refresh",
    "allow-set-favorite-alerts",
    "allow-set-close-to-tray"
  ]
}
